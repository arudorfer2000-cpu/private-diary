{
  "expo": {
    "name": "Private Diary",
    "slug": "private-diary",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A1214",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A1214",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Private Diary to use Face ID to unlock your diary."
        }
      ],
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Private Diary reads a photo only when you choose one to attach to an entry. It is stored encrypted on this device."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Private Diary reads your position only when you tap Add location. It is stored encrypted on this device and never sent anywhere."
        }
      ]
    ]
  }
}